{
  "manifest_version": 3,
  "name": "Utilities App Extension",
  "version": "1.0.0",
  "description": "A simple bootstrap Chrome extension for the Utilities App project.",
  "permissions": ["storage", "tabs", "activeTab"],
  "action": {
    "default_title": "Utilities App Extension",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
